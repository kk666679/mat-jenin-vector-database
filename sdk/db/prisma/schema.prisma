// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

// ============================================
// TENANT & USER MANAGEMENT
// ============================================

model Tenant {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  plan        String    @default("free") // "free", "pro", "enterprise"
  isActive    Boolean   @default(true)
  
  // Database per tenant option (for enterprise)
  databaseUrl String?
  
  // Limits
  maxUsers        Int       @default(5)
  maxDocuments    Int       @default(100)
  maxStorageMb    Int       @default(1000)
  rateLimitRpm    Int       @default(60)  // requests per minute
  rateLimitRph    Int       @default(1000) // requests per hour
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users       User[]
  documents   Document[]
  sessions    Session[]
  apiKeys     ApiKey[]
  auditLogs   AuditLog[]
  usageMetrics UsageMetric[]
  conversations Conversation[]
  webhooks    Webhook[]

  @@index([slug])
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  passwordHash String
  name        String
  role        String    @default("member") // "admin", "member"
  avatarUrl   String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions    Session[]
  auditLogs   AuditLog[]

  @@unique([email, tenantId])
  @@index([tenantId])
}

// ============================================
// AUTHENTICATION
// ============================================

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  token        String   @unique
  refreshToken String?  @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  
  @@index([tenantId])
  @@index([userId])
}

model ApiKey {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  keyHash     String   @unique // Store hashed version of the key
  prefix      String   // First few chars for display (e.g., "sk-test-...")
  permissions String   // JSON array of permissions
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rateLimitLogs RateLimitLog[]
  
  @@index([tenantId])
  @@index([keyHash])
}

// ============================================
// DOCUMENTS
// ============================================

model Document {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  title       String
  filename    String?
  contentType String?
  fileSize    Int?      // in bytes
  content     String?   // original text or file reference
  fileUrl     String?   // S3/Azure Blob URL
  
  status      String    @default("pending") // "pending", "processing", "completed", "failed"
  chunkCount  Int       @default(0)
  
  // Processing metadata
  processedAt DateTime?
  errorMessage String?
  
  // User who created this document
  createdBy   String?
  userId      String?   // kept for backward compatibility
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chunks      DocumentChunk[]
  jobs        Job[]
  auditLogs   AuditLog[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([createdAt])
  @@index([createdBy])
}

// DocumentChunk - stores vector embeddings for document chunks
model DocumentChunk {
  id          String    @id @default(uuid())
  tenantId    String    // explicit tenant isolation
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  content     String    // chunk text content
  chunkIndex  Int       // position in document
  embedding   String?   // stored as JSON string for database fallback
  embeddingId String?   // vector DB ID (Weaviate)
  
  // Metadata
  metadata    String?   // additional metadata JSON
  
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([documentId])
  @@index([tenantId, embeddingId])
}

// ============================================
// QUEUE JOBS
// ============================================

model Job {
  id          String    @id @default(uuid())
  tenantId    String    // explicit tenant isolation
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  type        String    // "embedding", "indexing", "processing"
  status      String    @default("pending") // "pending", "processing", "completed", "failed"
  progress    Int       @default(0)
  
  result      String?   // result JSON
  error       String?   // error message
  
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([documentId])
  @@index([tenantId, status])
}

// ============================================
// RATE LIMITING
// ============================================

model RateLimitLog {
  id          String   @id @default(uuid())
  apiKeyId    String?
  apiKey      ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  tenantId    String
  endpoint    String
  method      String
  ipAddress   String?
  statusCode  Int
  responseTime Int?    // in milliseconds
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([apiKeyId, createdAt])
}

// ============================================
// AUDIT & LOGGING
// ============================================

model AuditLog {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "AuditLog_User_fkey")
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "AuditLog_Document_fkey")
  
  action      String    // "create", "update", "delete", "login", "logout"
  entityType  String    // "document", "user", "api_key", etc.
  entityId    String?
  details     String?   // JSON with additional details
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType])
  @@index([userId, createdAt])
}

// ============================================
// USAGE METRICS
// ============================================

model UsageMetric {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  metricType  String   // "api_requests", "documents_processed", "tokens_used", "storage_mb", "embedding_generated"
  value       Int
  period      String   // "hourly", "daily", "monthly"
  periodStart DateTime // start of the period
  
  createdAt   DateTime @default(now())

  @@unique([tenantId, metricType, periodStart])
  @@index([tenantId, periodStart])
  @@index([metricType, periodStart])
}

// ============================================
// CHAT & CONVERSATIONS (Future RAG Chat)
// ============================================

model Conversation {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  messages    Message[]
  
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  role           String   // "user", "assistant"
  content        String
  
  // RAG specific
  sources        String?  // JSON array of source documents used
  tokensUsed     Int?
  
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

// ============================================
// WEBHOOKS
// ============================================

model Webhook {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String
  url         String
  events      String   // JSON array of event types
  secret      String?  // HMAC secret for signature verification
  isActive    Boolean  @default(true)
  retryCount  Int      @default(3)
  timeout     Int      @default(30000) // milliseconds
  headers     String?  // JSON object of custom headers
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries  WebhookDelivery[]
  
  @@index([tenantId])
  @@index([isActive])
}

model WebhookDelivery {
  id          String    @id @default(uuid())
  webhookId   String
  webhook     Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  tenantId    String
  
  event       String
  payload     String    // JSON payload
  status      String    @default("pending") // "pending", "success", "failed"
  statusCode  Int?
  response    String?
  error       String?
  attempts    Int       @default(0)
  nextRetryAt DateTime?
  deliveredAt DateTime?
  
  createdAt   DateTime  @default(now())
  
  @@index([webhookId])
  @@index([tenantId])
  @@index([status])
  @@index([nextRetryAt])
}

