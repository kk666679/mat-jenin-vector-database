{
  "name": "matjenin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit --project tsconfig.build.json",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:validate": "prisma validate",
    "db:diff": "prisma migrate diff --exit-code",
    "start": "next start",
    "worker": "npx tsx app/worker/index.ts",
    "grpc": "tsx server/grpc/server.ts",
    "ci": "npm run db:validate && npm run db:diff && npm run typecheck && npm run lint && npm run build"
  },
