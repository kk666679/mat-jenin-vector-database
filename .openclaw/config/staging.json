{
  "version": "1.0.0",
  "environment": "staging",
  "agentSystem": {
    "maxConcurrentTasks": 25,
    "taskTimeout": 45000,
    "enableParallelExecution": true,
    "retryOnFailure": true,
    "maxRetries": 3
  },
  "queue": {
    "concurrency": 15,
    "maxAttempts": 3,
    "removeOnComplete": 50,
    "removeOnFail": 50,
    "stalledInterval": 30000,
    "maxStalledCount": 3
  },
  "logging": {
    "level": "info",
    "pretty": true,
    "format": "json"
  },
  "monitoring": {
    "enabled": true,
    "metricsInterval": 30000,
    "alertThresholds": {
      "errorRate": 0.05,
      "queueLength": 500,
      "responseTime": 3000
    }
  }
}
